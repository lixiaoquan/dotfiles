#!/bin/bash

_network_environment_url="http://envcheck.denglin.com:1314/?format=json"
_network_environment_checked=0
_network_environment_json=""

_fetch_network_environment() {
    if [ "$_network_environment_checked" -eq 1 ]; then
        [ -n "$_network_environment_json" ]
        return
    fi

    _network_environment_checked=1

    if ! command -v curl &>/dev/null; then
        return 1
    fi

    _network_environment_json=$(curl -fsS --connect-timeout 1 --max-time 2 "$_network_environment_url" 2>/dev/null) || {
        _network_environment_json=""
        return 1
    }
}

_parse_is_dev_environment() {
    printf '%s\n' "$_network_environment_json" | sed -n 's/.*"is_dev"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p'
}

is_internal_network() {
    local is_dev=""

    if _fetch_network_environment; then
        is_dev=$(_parse_is_dev_environment)
        case "$is_dev" in
            true)
                return 0
                ;;
            false)
                return 1
                ;;
        esac
    fi

    return 1
}
